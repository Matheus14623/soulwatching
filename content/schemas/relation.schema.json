{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/relation.schema.json",
  "title": "Relação pública tipada",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "id",
    "order",
    "source",
    "target",
    "type",
    "label",
    "justification",
    "referenceIds",
    "reviewState"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "relation"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-r[1-9][0-9]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:--[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "theory",
            "figure",
            "publication",
            "experiment"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "theory",
            "figure",
            "publication",
            "experiment"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 2
    },
    "justification": {
      "type": "string",
      "minLength": 30
    },
    "referenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "deprecated"
      ]
    },
    "reviewedAgainst": {
      "type": "object",
      "required": [
        "mode",
        "sourceRevisionId",
        "targetRevisionId"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "legacy-baseline",
            "editorial-review"
          ]
        },
        "sourceRevisionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
        },
        "targetRevisionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 2
        }
      },
      "additionalProperties": false
    },
    "legacyDirection": {
      "type": "string",
      "enum": [
        "reversed"
      ]
    }
  },
  "additionalProperties": false
}
