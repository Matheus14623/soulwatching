{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/path.schema.json",
  "title": "Rota Guiada",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "id",
    "slug",
    "aliases",
    "order",
    "title",
    "summary",
    "audience",
    "durationMinutes",
    "accent",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "path"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "audience": {
      "type": "string",
      "minLength": 3
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "accent": {
      "type": "string",
      "enum": [
        "cyan",
        "purple",
        "gold",
        "green"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "type",
          "id",
          "reason"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "theory",
              "figure",
              "experiment",
              "publication"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
