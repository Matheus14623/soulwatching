{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/figure.schema.json",
  "title": "Perfil histórico público",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "order",
    "aliases",
    "id",
    "slug",
    "name",
    "lifespan",
    "area",
    "role",
    "featuredRank",
    "portrait",
    "summary",
    "impact",
    "contributions",
    "milestones",
    "referenceIds"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "figure"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "lifespan": {
      "type": "string",
      "minLength": 3
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 3
    },
    "featuredRank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "portrait": {
      "type": "object",
      "required": [
        "src",
        "width",
        "height",
        "alt",
        "credit",
        "license",
        "sourceUrl"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string",
          "minLength": 3
        },
        "credit": {
          "type": "string",
          "minLength": 3
        },
        "license": {
          "type": "string",
          "minLength": 2
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "modifications": {
          "type": "string",
          "minLength": 3
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "impact": {
      "type": "string",
      "minLength": 40
    },
    "contributions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "referenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "additionalProperties": false
}
