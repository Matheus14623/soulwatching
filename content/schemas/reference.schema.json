{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/reference.schema.json",
  "title": "Referência pública normalizada",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "id",
    "aliases",
    "title",
    "kind",
    "url"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "reference"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "authors": {
      "type": "string",
      "minLength": 2
    },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "role": {
            "type": "string",
            "enum": [
              "author",
              "editor",
              "organization"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "institution": {
      "type": "string",
      "minLength": 2
    },
    "publisher": {
      "type": "string",
      "minLength": 2
    },
    "year": {
      "type": "string",
      "minLength": 2
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "accessedAt": {
      "type": "string",
      "format": "date"
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
    },
    "kind": {
      "type": "string",
      "minLength": 2
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "archived",
        "restricted",
        "unavailable",
        "unknown"
      ]
    },
    "license": {
      "type": "object",
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "minLength": 3
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "additionalProperties": false
}
