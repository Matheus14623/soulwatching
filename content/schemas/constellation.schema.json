{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/constellation.schema.json",
  "title": "Campo de reconhecimento de constelação",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "id",
    "slug",
    "aliases",
    "order",
    "name",
    "latinName",
    "abbreviation",
    "featuredRank",
    "seasonId",
    "season",
    "signature",
    "recognition",
    "fact",
    "guideNote",
    "sourceIds",
    "relatedConstellationIds",
    "stars",
    "lines"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "constellation"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "latinName": {
      "type": "string",
      "minLength": 2
    },
    "abbreviation": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]{2}$"
    },
    "featuredRank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "seasonId": {
      "type": "string",
      "enum": [
        "verao",
        "outono",
        "inverno",
        "primavera"
      ]
    },
    "season": {
      "type": "string",
      "minLength": 2
    },
    "signature": {
      "type": "string",
      "minLength": 2
    },
    "recognition": {
      "type": "string",
      "minLength": 10
    },
    "fact": {
      "type": "string",
      "minLength": 10
    },
    "guideNote": {
      "type": "string",
      "minLength": 10
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "relatedConstellationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "stars": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "designation",
          "magnitude",
          "x",
          "y",
          "tone",
          "role",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "chartLabel": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "magnitude": {
            "type": "number"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "tone": {
            "type": "string",
            "enum": [
              "warm",
              "cool",
              "white"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "anchor",
              "guide",
              "context",
              "landmark"
            ]
          },
          "label": {
            "type": "boolean"
          },
          "combined": {
            "type": "boolean"
          },
          "variable": {
            "type": "boolean"
          },
          "labelDx": {
            "type": "number"
          },
          "labelDy": {
            "type": "number"
          },
          "labelAnchor": {
            "type": "string",
            "enum": [
              "start",
              "middle",
              "end"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  },
  "additionalProperties": false
}
