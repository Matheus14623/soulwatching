{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/theory.schema.json",
  "title": "Linha de investigação pública",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "order",
    "aliases",
    "id",
    "slug",
    "code",
    "title",
    "shortTitle",
    "subtitle",
    "kind",
    "reviewState",
    "independent",
    "category",
    "filters",
    "color",
    "glow",
    "position",
    "summary",
    "proposal",
    "questions",
    "concepts",
    "nextSteps",
    "referenceIds",
    "claimLinks",
    "objections",
    "decisionBoundary",
    "review",
    "revisions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "theory"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "code": {
      "type": "string",
      "pattern": "^T-[0-9]{2,}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "shortTitle": {
      "type": "string",
      "minLength": 3
    },
    "subtitle": {
      "type": "string",
      "minLength": 10
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "reviewState": {
      "type": "string",
      "minLength": 1
    },
    "independent": {
      "type": "boolean"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "glow": {
      "type": "string",
      "minLength": 1
    },
    "position": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "proposal": {
      "type": "string",
      "minLength": 20
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "nextSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "referenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "claimLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "field",
          "referenceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 2
          },
          "field": {
            "type": "string",
            "enum": [
              "summary",
              "proposal",
              "review.assessment",
              "review.known",
              "review.focus",
              "review.limit",
              "review.test"
            ]
          },
          "referenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "objections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "response"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 10
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "type": "string",
            "minLength": 20
          }
        },
        "additionalProperties": false
      }
    },
    "decisionBoundary": {
      "type": "object",
      "required": [
        "revise",
        "abandon"
      ],
      "properties": {
        "revise": {
          "type": "string",
          "minLength": 20
        },
        "abandon": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "assessment",
        "known",
        "focus",
        "limit",
        "test"
      ],
      "properties": {
        "assessment": {
          "type": "string",
          "minLength": 5
        },
        "known": {
          "type": "string",
          "minLength": 20
        },
        "focus": {
          "type": "string",
          "minLength": 20
        },
        "limit": {
          "type": "string",
          "minLength": 20
        },
        "test": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "revisionId",
          "ordinal",
          "versionLabel",
          "reviewedAt",
          "label",
          "changeSummary",
          "responsibles"
        ],
        "properties": {
          "revisionId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "versionLabel": {
            "type": "string",
            "minLength": 1
          },
          "reviewedAt": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string",
            "minLength": 3
          },
          "changeSummary": {
            "type": "string",
            "minLength": 10
          },
          "responsibles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "role"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2
                },
                "role": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
