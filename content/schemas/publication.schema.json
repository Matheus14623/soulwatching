{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/publication.schema.json",
  "title": "Publicação editorial pública",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "id",
    "slug",
    "aliases",
    "title",
    "summary",
    "body",
    "publicationType",
    "authorshipOrigin",
    "availabilityState",
    "credits",
    "textLicense",
    "assetRights",
    "claimLinks",
    "publicDeclarations",
    "referenceIds",
    "revisions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "publication"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading",
          "paragraphs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "heading": {
            "type": "string",
            "minLength": 2
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "authorshipOrigin": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "publicationType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "availabilityState": {
      "type": "string",
      "enum": [
        "published",
        "superseded",
        "withdrawn",
        "retracted",
        "archived"
      ]
    },
    "credits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "displayName",
          "order",
          "roles",
          "authorizedLinks"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "author",
                "coauthor",
                "editor",
                "reviewer",
                "illustrator",
                "developer",
                "translator",
                "research",
                "visualization"
              ]
            }
          },
          "partyId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "partyType": {
            "type": "string",
            "enum": [
              "person",
              "organization"
            ]
          },
          "publicProfileLinkAuthorized": {
            "type": "boolean"
          },
          "declaredAffiliation": {
            "type": "string",
            "minLength": 2
          },
          "authorizedLinks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "textLicense": {
      "type": "object",
      "required": [
        "identifier",
        "label",
        "url",
        "rightsHolder"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 2
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "rightsHolder": {
          "type": "string",
          "minLength": 2
        }
      },
      "additionalProperties": false
    },
    "assetRights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "kind",
          "publicPath",
          "rightsBasis",
          "credit"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "graphic",
              "code",
              "dataset",
              "attachment"
            ]
          },
          "publicPath": {
            "type": "string",
            "pattern": "^/"
          },
          "rightsBasis": {
            "type": "string",
            "enum": [
              "owned",
              "licensed",
              "public-domain"
            ]
          },
          "licenseIdentifier": {
            "type": "string",
            "minLength": 2
          },
          "credit": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": false
      }
    },
    "claimLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "contentBlockId",
          "sources"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "contentBlockId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "referenceId",
                "role"
              ],
              "properties": {
                "referenceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "contextualizes",
                    "contrasts"
                  ]
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "publicDeclarations": {
      "type": "object",
      "required": [
        "publicNameAuthorization",
        "finalVersionApproval",
        "conflictOfInterest",
        "editorialReview"
      ],
      "properties": {
        "publicNameAuthorization": {
          "type": "string",
          "const": "confirmed"
        },
        "finalVersionApproval": {
          "type": "string",
          "const": "confirmed"
        },
        "conflictOfInterest": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "none-declared",
                "declared"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 3
            }
          },
          "additionalProperties": false
        },
        "editorialReview": {
          "type": "object",
          "required": [
            "state",
            "description",
            "peerReview"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "completed",
                "not-applicable"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 10
            },
            "peerReview": {
              "type": "boolean",
              "const": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "referenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "publicNotice": {
      "type": "object",
      "required": [
        "type",
        "effectiveAt",
        "affectedRevisionId",
        "reason",
        "decisionAuthority",
        "contest"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "superseded",
            "withdrawn",
            "retracted",
            "archived"
          ]
        },
        "effectiveAt": {
          "type": "string",
          "format": "date"
        },
        "affectedRevisionId": {
          "type": "string",
          "minLength": 3
        },
        "reason": {
          "type": "string",
          "minLength": 10
        },
        "decisionAuthority": {
          "type": "string",
          "enum": [
            "author-request",
            "editorial-decision",
            "joint-decision",
            "legal-requirement"
          ]
        },
        "contest": {
          "type": "object",
          "required": [
            "channelPath",
            "responseWindowDays",
            "instructions"
          ],
          "properties": {
            "channelPath": {
              "type": "string",
              "pattern": "^/"
            },
            "responseWindowDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "instructions": {
              "type": "string",
              "minLength": 10
            }
          },
          "additionalProperties": false
        },
        "replacementPublicationId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "revisionId",
          "ordinal",
          "revisionEventType",
          "publishedAt",
          "changeSummary",
          "publicSnapshot",
          "creditSnapshot",
          "contentHash"
        ],
        "properties": {
          "revisionId": {
            "type": "string",
            "minLength": 3
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "revisionEventType": {
            "type": "string",
            "enum": [
              "initial-publication",
              "update",
              "correction",
              "metadata-fix"
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date"
          },
          "changeSummary": {
            "type": "string",
            "minLength": 10
          },
          "publicSnapshot": {
            "type": "object",
            "required": [
              "title",
              "summary",
              "body",
              "referenceIds",
              "claimIds",
              "textLicenseIdentifier",
              "assetIds"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3
              },
              "summary": {
                "type": "string",
                "minLength": 20
              },
              "body": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "heading",
                    "paragraphs"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "heading": {
                      "type": "string",
                      "minLength": 2
                    },
                    "paragraphs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "referenceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "claimIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "textLicenseIdentifier": {
                "type": "string",
                "minLength": 2
              },
              "assetIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "additionalProperties": false
          },
          "creditSnapshot": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "displayName",
                "order",
                "roles",
                "authorizedLinks"
              ],
              "properties": {
                "displayName": {
                  "type": "string",
                  "minLength": 2
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "author",
                      "coauthor",
                      "editor",
                      "reviewer",
                      "illustrator",
                      "developer",
                      "translator",
                      "research",
                      "visualization"
                    ]
                  }
                },
                "partyId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "partyType": {
                  "type": "string",
                  "enum": [
                    "person",
                    "organization"
                  ]
                },
                "publicProfileLinkAuthorized": {
                  "type": "boolean"
                },
                "declaredAffiliation": {
                  "type": "string",
                  "minLength": 2
                },
                "authorizedLinks": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
