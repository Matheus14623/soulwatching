{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/figure-taxonomy.schema.json",
  "title": "Vocabulários de Grandes Nomes",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "areas",
    "timelineCategories"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "figure-taxonomy"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "timelineCategories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
