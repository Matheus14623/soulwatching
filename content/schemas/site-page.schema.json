{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/site-page.schema.json",
  "title": "Metadados públicos de página institucional",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "order",
    "id",
    "label",
    "functionalLabel",
    "title",
    "description",
    "keywords",
    "matchPaths",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "site-page"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 2
    },
    "functionalLabel": {
      "type": "string",
      "minLength": 4
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "matchPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?:$|[A-Za-z0-9._/-]+)$"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "title",
          "description",
          "keywords"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 2
          },
          "title": {
            "type": "string",
            "minLength": 6
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "keywords": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
