{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/research-track.schema.json",
  "title": "Linha do radar de desenvolvimento",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisionId",
    "id",
    "slug",
    "aliases",
    "order",
    "code",
    "title",
    "kind",
    "summary",
    "boundary",
    "nextStep"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "research-track"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-r[1-9][0-9]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "code": {
      "type": "string",
      "pattern": "^R-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "boundary": {
      "type": "string",
      "minLength": 20
    },
    "nextStep": {
      "type": "string",
      "minLength": 20
    }
  },
  "additionalProperties": false
}
