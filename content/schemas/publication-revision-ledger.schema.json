{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio.local/schemas/publication-revision-ledger.schema.json",
  "title": "Registro imutável das revisões publicadas",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "revisions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entityType": {
      "type": "string",
      "const": "publication-revision-ledger"
    },
    "revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "publicationId",
          "contentHash",
          "publishedAt"
        ],
        "properties": {
          "publicationId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "publishedAt": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
