{
  "name": "matheus-observatorio-ideias",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Site estático, filosófico e interativo para o Observatório de Ideias de Matheus Camargo, com página dedicada e escalável de teorias.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/build.mjs",
    "knowledge:build": "node ai/tools/build-source-coverage-ledger.mjs && node ai/tools/build-knowledge-graph.mjs",
    "knowledge:check": "node ai/tools/build-source-coverage-ledger.mjs --check && node ai/tools/build-knowledge-graph.mjs --check",
    "knowledge:test": "node --test ai/tools/tests/knowledge-tools.test.mjs"
  },
  "keywords": [
    "static-site",
    "philosophy",
    "cosmology",
    "canvas",
    "accessibility",
    "matheus-camargo"
  ],
  "license": "UNLICENSED"
}
