{
  "name": "matheus-observatorio-ideias",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "description": "Site estático, filosófico e interativo para o Observatório de Ideias de Matheus Camargo, com página dedicada e escalável de teorias.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --source",
    "start": "node scripts/serve.mjs --source",
    "dashboard": "node tools/editorial-dashboard/server.mjs",
    "prepreview": "npm run build",
    "preview": "node scripts/serve.mjs --dist",
    "verify": "node scripts/verify.mjs",
    "verify:editorial": "node scripts/verify-editorial.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "content:new": "node scripts/content/cli.mjs new",
    "content:check": "node scripts/content/cli.mjs check",
    "content:build": "node scripts/content/cli.mjs build",
    "content:report": "node scripts/content/cli.mjs report",
    "content:impact": "node scripts/content/cli.mjs impact",
    "content:apply": "node scripts/content/cli.mjs apply",
    "content:rollback": "node scripts/content/cli.mjs rollback",
    "prebuild": "node scripts/check-node-version.cjs",
    "build": "node scripts/build.mjs",
    "build:deploy": "node scripts/build-deploy.mjs",
    "pretest": "npm run build",
    "test": "npm run test:smoke",
    "test:smoke": "node --test --test-concurrency=1 scripts/tests/public-smoke.test.mjs scripts/tests/accessibility-contracts.test.mjs scripts/tests/feature-contracts.test.mjs scripts/tests/contributions-contracts.test.mjs scripts/tests/pix-support-contracts.test.mjs scripts/tests/content-platform-contracts.test.mjs scripts/tests/editorial-impact-contracts.test.mjs scripts/tests/content-dependencies-contracts.test.mjs scripts/tests/editorial-change-set-contracts.test.mjs scripts/tests/editorial-dashboard-contracts.test.mjs scripts/tests/observacao-impact-fixture.test.mjs scripts/tests/content-migrations-contracts.test.mjs scripts/tests/contribution-draft-contracts.test.mjs scripts/tests/navigation-continuity-contracts.test.mjs scripts/tests/public-metadata-contracts.test.mjs scripts/tests/public-content-metrics-contracts.test.mjs scripts/tests/publication-contracts.test.mjs scripts/tests/syntax-contracts.test.mjs scripts/tests/external-links-contracts.test.mjs scripts/tests/browser-smoke.test.mjs tools/editorial-dashboard/tests/apply-preview-contracts.test.mjs tools/editorial-dashboard/tests/server-contracts.test.mjs tools/editorial-dashboard/tests/ui-context-contracts.test.mjs tools/editorial-dashboard/tests/workflow-contracts.test.mjs tools/editorial-dashboard/tests/workspace-contracts.test.mjs",
    "test:dashboard": "node --test --test-concurrency=1 scripts/tests/editorial-dashboard-contracts.test.mjs tools/editorial-dashboard/tests/apply-preview-contracts.test.mjs tools/editorial-dashboard/tests/server-contracts.test.mjs tools/editorial-dashboard/tests/ui-context-contracts.test.mjs tools/editorial-dashboard/tests/workflow-contracts.test.mjs tools/editorial-dashboard/tests/workspace-contracts.test.mjs",
    "test:dashboard:preview": "node tools/editorial-dashboard/tests/preview-smoke.mjs",
    "knowledge:build": "node ai/tools/build-source-coverage-ledger.mjs && node ai/tools/build-knowledge-graph.mjs",
    "knowledge:check": "node ai/tools/build-source-coverage-ledger.mjs --check && node ai/tools/build-knowledge-graph.mjs --check",
    "knowledge:test": "node --test ai/tools/tests/knowledge-tools.test.mjs"
  },
  "keywords": [
    "static-site",
    "philosophy",
    "cosmology",
    "canvas",
    "accessibility",
    "matheus-camargo"
  ],
  "license": "UNLICENSED"
}
